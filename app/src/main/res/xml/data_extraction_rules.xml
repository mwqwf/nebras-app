<?xml version="1.0" encoding="utf-8"?>
<!--
  Data Extraction Rules لـ Android 12+ (API 31+).
  cloud-backup  = نسخ احتياطيّ تلقائيّ إلى Google Drive (مفعَّل).
  device-transfer = نقل من جهاز إلى آخر مباشرة (مفعَّل).
  نستثني نفس صناديق Hive (و ملفات `.lock` المرافقة) في الموضعَين.

  ملاحظة: `allowBackup="false"` في AndroidManifest يُلغي تطبيق هذه
  القواعد عملياً. مُحتفَظ بها كتوثيق في حال إعادة تفعيل Backup لاحقاً.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="hive/" />
        <exclude domain="file" path="content_metadata_cache.hive" />
        <exclude domain="file" path="downloads.hive" />
        <exclude domain="file" path="saved_items.hive" />
        <exclude domain="file" path="notifications.hive" />
        <exclude domain="file" path="content_metadata_cache.lock" />
        <exclude domain="file" path="downloads.lock" />
        <exclude domain="file" path="saved_items.lock" />
        <exclude domain="file" path="notifications.lock" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="hive/" />
        <exclude domain="file" path="content_metadata_cache.hive" />
        <exclude domain="file" path="downloads.hive" />
        <exclude domain="file" path="saved_items.hive" />
        <exclude domain="file" path="notifications.hive" />
        <exclude domain="file" path="content_metadata_cache.lock" />
        <exclude domain="file" path="downloads.lock" />
        <exclude domain="file" path="saved_items.lock" />
        <exclude domain="file" path="notifications.lock" />
    </device-transfer>
</data-extraction-rules>
